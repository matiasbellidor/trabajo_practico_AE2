<!doctype html>
<html lang="es-AR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Recursos · Guion de la exposición</title>
<meta name="description" content="Guion de cada orador para la exposición del TP de {{ r.meta.materia }} ({{ r.meta.grupo }}). Se abre con el código del grupo.">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#111726">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23111726'/%3E%3Cpath d='M5 22l6-7 5 4 5-9 6 6' fill='none' stroke='%233b8beb' stroke-width='2.6' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
<style>
{{ css | safe }}
</style>
</head>
<body>
<a class="saltar" href="#contenido">Saltar al contenido</a>
<header class="cab">
  {#- Siempre "Volver al inicio" (la web del trabajo), igual que en el deck; no "ver la presentación" (pedido de Matías). -#}
  <a class="cab__volver" href="../../" data-volver-inicio title="Volver a la web del trabajo"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg><span>Volver al inicio</span></a>
  <p class="cab__titulo">Recursos <span>· {{ r.meta.grupo }}</span></p>
  <div class="cab__acciones" data-acciones hidden>
    <div class="reloj" data-reloj-caja>
      <span class="reloj__tiempo" data-reloj aria-label="Tiempo transcurrido">0:00</span>
      <span class="reloj__plan" data-plan></span>
    </div>
    <button class="boton" type="button" data-reloj-boton aria-pressed="false" aria-keyshortcuts="T"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5.5v13l10-6.5z"/></svg><span class="boton__texto" data-reloj-texto>Empezar</span></button>
    <button class="boton boton--icono" type="button" data-reloj-reiniciar aria-label="Reiniciar el reloj"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12a8 8 0 1 0 2.4-5.7L4 8.6M4 4v4.6h4.6"/></svg></button>
    <button class="boton" type="button" data-bloquear><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 11V8a5 5 0 0 1 10 0v3M5.5 11h13v9h-13z"/></svg><span class="boton__texto">Bloquear</span></button>
  </div>
</header>

<main id="contenido">
  <section class="puerta" data-puerta aria-labelledby="t-puerta">
    <div class="puerta__tarjeta">
      <svg class="puerta__icono" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 11V8a5 5 0 0 1 10 0v3"/><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M12 15v2"/></svg>
      <h1 id="t-puerta">Guion de la exposición</h1>
      <p class="puerta__bajada">Qué dice cada uno, con tiempos, pausas y pases. Se abre con el código del grupo.</p>
      <form class="codigo" data-codigo novalidate>
        <div class="codigo__cabecera">
          <label class="codigo__etiqueta" id="codigo-etiqueta" for="codigo-1">Código del grupo</label>
          <span class="codigo__formato" id="codigo-formato">3 números</span>
        </div>
        <div class="codigo__casillas" role="group" aria-labelledby="codigo-etiqueta codigo-formato">
          {% for i in range(1, 4) %}
          <input class="codigo__casilla" id="codigo-{{ i }}" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="off" autocorrect="off" spellcheck="false" aria-label="Número {{ i }} de 3" aria-describedby="codigo-ayuda codigo-error" data-casilla="{{ i - 1 }}">
          {% endfor %}
        </div>
        <p class="codigo__ayuda" id="codigo-ayuda" data-ayuda>Se abre solo al completar las tres casillas. También podés pegarlo.</p>
        <p class="codigo__error" id="codigo-error" data-error role="alert"></p>
        <button class="codigo__abrir" type="submit" data-abrir>Abrir el guion</button>
      </form>
    </div>
  </section>
  <section class="guion" data-guion hidden aria-label="Guion de la exposición"></section>
  <p class="sr-only" aria-live="polite" data-anuncio></p>
</main>

{#- El guion viaja cifrado (AES-GCM con una clave derivada del código por PBKDF2); el navegador lo descifra con
    WebCrypto. Lo público: título de cada diapositiva, su miniatura y dónde va cada marca. -#}
<script type="application/json" id="guion-cifrado">{{ cifrado | safe }}</script>
<script type="application/json" id="guion-publico">{{ publico | safe }}</script>
<script>
{{ js | safe }}
</script>
</body>
</html>
